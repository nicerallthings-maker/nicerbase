# NicerBase Cloud (docker-compose.cloud.yml). Copy to .env.cloud and replace every secret.
# Generate secrets with: openssl rand -hex 32

NICERBASE_PUBLIC_URL=http://localhost:4000
NICERBASE_SECRET_KEY=replace-with-64-hex-characters
TENANT_POSTGRES_PASSWORD=replace-with-a-strong-password
TENANT_MONGODB_USER=nicerbase
TENANT_MONGODB_PASSWORD=replace-with-a-strong-password

# Hostname customers use in their connection strings
NICERBASE_POSTGRES_PUBLIC_HOST=localhost
NICERBASE_MONGODB_PUBLIC_HOST=localhost

CLOUD_PORT=4000
TENANT_POSTGRES_PORT=5432
TENANT_MONGODB_PORT=27017
NICERBASE_MAX_PROJECTS_PER_USER=5

# Email (verification and password reset). Without SMTP, emails are printed in the
# cloud container log: docker compose -f docker-compose.cloud.yml logs cloud
NICERBASE_SMTP_URL=
NICERBASE_MAIL_FROM=NicerBase <no-reply@example.com>
# Defaults to true when NICERBASE_SMTP_URL is set
NICERBASE_REQUIRE_EMAIL_VERIFICATION=

# HTTPS (docker-compose.cloud.https.yml). Also set NICERBASE_PUBLIC_URL=https://<domain>
NICERBASE_DOMAIN=

# Backups (written to docker/volumes/cloud-backups)
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7
