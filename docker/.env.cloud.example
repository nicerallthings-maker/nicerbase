# NicerBase Cloud (docker-compose.cloud.yml). Copy to .env.cloud and replace every secret.
# Generate secrets with: openssl rand -hex 32

NICERBASE_PUBLIC_URL=http://localhost:4000
NICERBASE_SECRET_KEY=replace-with-64-hex-characters
TENANT_POSTGRES_PASSWORD=replace-with-a-strong-password
TENANT_MONGODB_USER=nicerbase
TENANT_MONGODB_PASSWORD=replace-with-a-strong-password

# Hostname customers use in their connection strings
NICERBASE_POSTGRES_PUBLIC_HOST=localhost
NICERBASE_MONGODB_PUBLIC_HOST=localhost

CLOUD_PORT=4000
TENANT_POSTGRES_PORT=5432
TENANT_MONGODB_PORT=27017
NICERBASE_MAX_PROJECTS_PER_USER=5
